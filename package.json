{
  "name": "panda-gen-code",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/fetch-zodiak.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/fetch-zodiak.mjs",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next build",
    "blog:covers": "node scripts/generate-blog-covers.mjs",
    "analyze": "cross-env ANALYZE=true NODE_OPTIONS=--max-old-space-size=8192 next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "npm run test:audit-security && npm run test:forms && npm run test:crm && npm run test:catalog && npm run test:analytics",
    "test:analytics": "node --test scripts/analytics-tracking.test.mjs",
    "test:audit-security": "node --test src/lib/audit/__tests__/*.test.mjs",
    "test:forms": "node --test src/lib/forms/__tests__/*.test.mjs",
    "test:crm": "node --test src/lib/crm/__tests__/*.test.mjs",
    "claims:check": "node scripts/check-public-claims.mjs",
    "dates:check": "python scripts/check_dates.py",
    "guard:metrics": "python scripts/test_metrics_guard.py && python scripts/metrics_guard.py",
    "guard:links": "python scripts/link_guard.py",
    "guard:specs": "python scripts/spec_freshness.py",
    "guard:glossary": "python scripts/glossary_guard.py",
    "guard:unicode": "python scripts/unicode_guard.py",
    "guard:retired": "python scripts/retired_claims.py",
    "guard:stamps": "python scripts/stamp_freshness.py --ratchet",
    "guard:descriptions": "python scripts/description_guard.py",
    "guard:all": "npm run guard:metrics && npm run guard:links && npm run guard:specs && npm run guard:glossary && npm run guard:unicode && npm run guard:retired && npm run guard:stamps && npm run guard:descriptions",
    "check": "npm run typecheck && npm run lint && npm test && npm run claims:check && npm run dates:check",
    "smoke:release": "node release-smoke.mjs",
    "seo:check": "node seo-audit.mjs",
    "schema:check": "node --test scripts/audit-structured-data.test.mjs && node scripts/audit-structured-data.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "indexnow": "node indexnow-ping.mjs",
    "verify": "npm run check && npm run build && npm run schema:check && npm run guard:all",
    "assistant:questions": "node scripts/assistant-questions.mjs",
    "test:catalog": "node --test public/resources/product-catalog-example/catalog.test.mjs"
  },
  "browserslist": [
    "chrome >= 111",
    "firefox >= 111",
    "safari >= 16.4",
    "edge >= 111",
    "ios >= 16.4",
    "not ie 11",
    "not dead"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@calcom/embed-react": "^1.5.3",
    "@vercel/analytics": "^1.6.1",
    "framer-motion": "^11.0.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.64.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.35.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.4.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "latest",
    "eslint-config-next": "16.4.3",
    "postcss": "8.5.32",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.32",
    "sharp": "0.35.5"
  }
}
