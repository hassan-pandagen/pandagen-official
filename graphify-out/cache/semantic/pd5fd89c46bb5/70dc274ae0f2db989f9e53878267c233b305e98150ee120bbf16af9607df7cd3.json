, {"id": "1039291_classifier_psi_a", "label": "Classifier \u03a8A: Coordinated Bot-Net Detection (Account Relatedness)", "file_type": "concept", "source_file": "1039291.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses internal Google infrastructure signals (API usage patterns, event time series, GenAI-specific metadata) to cluster accounts likely controlled by the same actor or automated generation script, reducing compute cost per decision vs. individual video scans."}, {"id": "1039291_classifier_psi_c", "label": "Classifier \u03a8C: Synthetic Content & Slop Prevalence", "file_type": "concept", "source_file": "1039291.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scores content against Content Integrity benchmarks using textual and multimedia analysis to produce content-level synthetic classification tags."}, {"id": "1039291_synthetic_content_rater", "label": "Synthetic Content Rater (Two-Stage LLM Architecture)", "file_type": "concept", "source_file": "1039291.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Engineering enhancement to \u03a8C designed to manage high dimensionality of video data by transforming raw multimodal signals into actionable textual context before final classification."}, {"id": "1039291_stage1_multimodal_context_distillation", "label": "Stage 1: Multimodal Context Distillation (Feature Extraction)", "file_type": "concept", "source_file": "1039291.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Processes raw video frames, audio, transcripts using multimodal semantic embeddings and temporal behavioral signals (video text embeddings, salient terms, upload pacing, Pulsar visual embeddings) rather than pixel-level forensics, producing a compact integrity-aware textual summary."}, {"id": "1039291_stage2_channel_level_classifier", "label": "Stage 2: Channel-level Classifier", "file_type": "concept", "source_file": "1039291.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Makes the final determination via semantic reasoning over synthesized textual context summaries rather than raw video pixels."}, {"id": "1039291_lora", "label": "Low-Rank Adaptation (LoRA)", "file_type": "concept", "source_file": "1039291.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parameter-efficient fine-tuning technique reducing trainable parameters and memory footprint, enabling rapid retraining of adapters when new generative models emerge."}, {"id": "1039291_apo", "label": "Automatic Prompt Optimization (APO)", "file_type": "concept", "source_file": "1039291.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Allows prompt engineering to adapt to new 'Slop' trends faster than retraining a dense model."}, {"id": "1039291_gemini_2_0_flash", "label": "Gemini 2.0 Flash (base LLM)", "file_type": "concept", "source_file": "1039291.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "1039291_sora", "label": "Sora (generative video model, adversarial threat)", "file_type": "concept", "source_file": "1039291.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "1039291_kling", "label": "Kling (generative video model, adversarial threat)", "file_type": "concept", "source_file": "1039291.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "1039291_c2pa", "label": "Coalition for Content Provenance and Authenticity (C2PA)", "file_type": "