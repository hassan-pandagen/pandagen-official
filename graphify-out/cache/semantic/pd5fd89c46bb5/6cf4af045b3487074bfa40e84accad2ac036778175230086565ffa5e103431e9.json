{"nodes": [{"id": "docs_operations_sow_review_checklist_overview", "label": "Healthcare SOW review checkpoint: product/delivery/security/privacy/commercial-risk review of an owner-supplied draft with blank effective-date/signature fields, not evidence of an executed agreement; not PandaCodeGen's universal contract or refund template", "file_type": "document", "source_file": "docs/operations/SOW_REVIEW_CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_operations_sow_review_checklist_aligned_items", "label": "Directionally aligned SOW terms: 30/70 payment split, client control/transfer of domain/hosting/repo/CMS/analytics, client ownership of deliverables post-payment, PandaCodeGen retention of reusable tools, defined post-launch support window", "file_type": "concept", "source_file": "docs/operations/SOW_REVIEW_CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_operations_sow_review_checklist_contracting_identity", "label": "Contradiction: header/payment/signature sections name MC Patches LLC d/b/a PandaCodeGen while Section 1 uses PandaCodeGen LLC; draft names one managing-member signatory though owner said both founders may sign; Austin address is mailing-only, not registered", "file_type": "rationale", "source_file": "docs/operations/SOW_REVIEW_CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_operations_sow_review_checklist_delivery_acceptance", "label": "Contradiction: Section 5 gives a testing/acceptance period while Section 6 makes final 70% due at DNS cutover/repository transfer before all handover items are delivered; need one unambiguous Delivery Milestone definition", "file_type": "rationale", "source_file": "docs/operations/SOW_REVIEW_CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_operations_sow_review_checklist_cancellation_refund", "label": "Contradiction: draft gives client all delivered work/ownership on termination while owner says a full refund leaves client with content/accounts but no license to refunded custom code; needs separated termination scenarios and a value schedule", "file_type": "rationale", "source_file": "docs/operations/SOW_REVIEW_CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_operations_sow_review_checklist_revisions_support_warranty", "label": "Contradiction: draft combines 30-calendar-day support, 90-day quality warranty, integration cooperation, and 12-month latent-defect obligation as if one obligation, while the website lists 15/30 business-day package defaults that don't automatically govern this draft", "file_type": "rationale", "source_file": "docs/operations/SOW_REVIEW_CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_operations_sow_review_checklist_performance_accessibility", "label": "Performance and accessibility promises: Lighthouse lab score vs field CWV distinction, Google's actual good-FCP threshold is 1.8s not 1.0s, replace absolute WCAG 2.1 AA compliance promise with a scoped WCAG 2.2 AA target and remediation process", "file_type": "rationale", "source_file": "docs/operations/SOW_REVIEW_CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_operations_sow_review_checklist_hipaa_phi", "label": "HIPAA, PHI, forms, hosting, and tracking: 'contractor will not access/process/store patient data' conflicts with building/testing/logging PHI-bearing flows; every host/form/log/CRM/payment/analytics path needs a data-flow review and BAA; remove ad pixels/session replay from PHI-capable flows absent counsel sign-off", "file_type": "rationale", "source_file": "docs/operations/SOW_REVIEW_CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_operations_sow_review_checklist_ai_tooling", "label": "AI tooling and content operations: scope includes an Anthropic API integration for content ops but also bars sending client-confidential or 'PHI-adjacent' data to AI providers; 'PHI-adjacent' is undefined and needs a concrete data classification", "file_type": "rationale", "source_file": "docs/operations/SOW_REVIEW_CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_operations_sow_review_checklist_accounts_access", "label": "Accounts, repositories, access, and credentials: prefer client-provisioned production accounts, dedicated client repository excluding other clients' material, no API keys handed over in documents, time-limited least-privilege support access with a final revocation event", "file_type": "rationale", "source_file": "docs/operations/SOW_REVIEW_CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_operations_sow_review_checklist_ip_portfolio", "label": "Successful-project IP and portfolio use: assign client deliverables after full payment/acceptance; PandaCodeGen keeps pre-existing/reusable IP; no case study/screenshot/portfolio link authorized before project completion, launch, and written client approval; nofollow credit recommended over the draft's dofollow requirement", "file_type": "rationale", "source_file": "docs/operations/SOW_REVIEW_CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_operations_sow_review_checklist_scope_price_schedule", "label": "Scope, price, and schedule risk: up to 60 pages, custom motion, CMS, AI content ops, healthcare forms, integrations, accessibility, performance, migration, training, and BAA work in 4-6 weeks for $6,000 is flagged as a high delivery-risk combination", "file_type": "rationale", "source_file": "docs/operations/SOW_REVIEW_CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_operations_sow_review_checklist_liability_insurance", "label": "Liability, insurance, exclusivity, dispute terms: uncapped HIPAA/BAA exposure, broad indemnity, insurance-tied liability cap, 12-month latent-defect promise, attorney-fee shifting, and a 12-month/50-mile competitor restriction flagged as material risk for a $6,000 engagement", "file_type": "rationale", "source_file": "docs/operations/SOW_REVIEW_CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_operations_sow_review_checklist_owner_decisions", "label": "Precise owner decisions still needed: exact active entity/DBA and signers, definition of 'delivery' and the 70% trigger, IP-assignment scope, repository/portfolio rights, support-window timing, additional-warranty pricing, performance-scope breadth, arbitration jurisdiction intent, PHI-form/BAA coverage", "file_type": "concept", "source_file": "docs/operations/SOW_REVIEW_CHECKLIST.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_operations_sow_review_checklist_hhs_online_tracking_ref", "label": "Reference: HHS online tracking guidance", "file_type": "document", "source_file": "docs/operations/SOW_REVIEW_CHECKLIST.md", "source_location": null, "source_url": "https://www.hhs.gov/hipaa/for-professionals/privacy/guidance/hipaa-online-tracking/index.html", "captured_at": null, "author": null, "contributor": null}, {"id": "docs_operations_sow_review_checklist_hhs_cloud_computing_ref", "label": "Reference: HHS cloud-computing guidance", "file_type": "document", "source_file": "do