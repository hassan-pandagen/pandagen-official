# Google PageSpeed Insights (required by POST /api/audit/analyze)
PAGESPEED_API_KEY=

# Transactional lead email (required by quote and audit-lead submissions)
RESEND_API_KEY=
# A verified sender, for example: PandaCodeGen <website@example.com>
RESEND_FROM_EMAIL=
# Inbox that receives quote/contact requests. Defaults to info@pandacodegen.com.
QUOTE_RECIPIENT_EMAIL=
# Inbox that receives audit notifications. Falls back to RESEND_FROM_EMAIL.
AUDIT_NOTIFY_EMAIL=

# Optional analytics vendors. Their components still require visitor consent.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Optional functional vendors. They remain disabled when these are blank and
# still require Functional consent when configured.
# Example Cal slug: your-team/discovery
NEXT_PUBLIC_CAL_LINK=
# Full HTTPS embed URL from the verified Tawk.to property.
NEXT_PUBLIC_TAWK_EMBED_URL=

# Public audit and form abuse controls
# Use "redis" for Vercel/serverless and other horizontally scaled deployments.
AUDIT_RATE_LIMIT_MODE=redis
AUDIT_RATE_LIMIT_REDIS_REST_URL=https://your-database.upstash.io
AUDIT_RATE_LIMIT_REDIS_REST_TOKEN=
# Generate a random value of at least 32 characters. Used to HMAC client/target keys.
# Quote and audit-lead submissions share this durable backend for per-client,
# global, and duplicate-submission controls; raw IPs are never used as keys.
AUDIT_RATE_LIMIT_SECRET=

# Conservative defaults; uncomment only when tuning from observed traffic.
# AUDIT_RATE_LIMIT_IP_MAX=5
# AUDIT_RATE_LIMIT_IP_WINDOW_SECONDS=900
# AUDIT_RATE_LIMIT_TARGET_MAX=20
# AUDIT_RATE_LIMIT_TARGET_WINDOW_SECONDS=900
# AUDIT_RATE_LIMIT_GLOBAL_MAX=200
# AUDIT_RATE_LIMIT_GLOBAL_WINDOW_SECONDS=3600
# AUDIT_MAX_CONCURRENT=2

# Only ordinary web ports are accepted by default. Adding ports expands the
# endpoint's public port-scanning surface and should be a deliberate decision.
# AUDIT_ALLOWED_PORTS=80,443

# Existing Vercel KV / Upstash integration variables are also detected:
# KV_REST_API_URL + KV_REST_API_TOKEN, or
# UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN.
